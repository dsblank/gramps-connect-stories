{
  "name": "@gramps-connect/story",
  "version": "0.1.3",
  "description": "Read, write, validate and present .story.zip files: portable, versioned family-history stories.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsblank/gramps-connect-stories.git"
  },
  "homepage": "https://dsblank.github.io/gramps-connect-stories/",
  "bugs": "https://github.com/dsblank/gramps-connect-stories/issues",
  "keywords": [
    "genealogy",
    "gramps",
    "family-history",
    "story",
    "storymap",
    "maplibre"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./player": {
      "source": "./src/player/index.ts",
      "types": "./dist/types/player/index.d.ts",
      "default": "./dist/player.js"
    },
    "./editor": {
      "source": "./src/editor/index.ts",
      "types": "./dist/types/editor/index.d.ts",
      "default": "./dist/editor.js"
    },
    "./embed": "./dist/embed.js",
    "./schema/1.0": "./spec/1.0/story.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "spec",
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build.mjs && node scripts/build-site.mjs",
    "prepack": "node scripts/build.mjs",
    "generate": "node scripts/generate-validator.mjs",
    "test": "tsx --conditions=source --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/test-image.mjs && node scripts/test-player.mjs && npm run build:site && node scripts/test-embed.mjs && node scripts/test-site.mjs && node scripts/test-editor.mjs",
    "test:pack": "node scripts/test-pack.mjs",
    "test:python": "${PYTHON:-python3} -m unittest discover -s python && tsx scripts/test-python.ts"
  },
  "dependencies": {
    "@gramps-connect/gramps-date": "^0.1.0",
    "@openhistoricalmap/maplibre-gl-dates": "^1.4.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "maplibre-gl": "^6.3.0",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "maplibre-gl": ">=5",
    "react": "^18.2 || ^19",
    "react-dom": "^18.2 || ^19"
  },
  "peerDependenciesMeta": {
    "@mantine/core": {
      "optional": true
    },
    "@mantine/hooks": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
