{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "types": [
      "node"
    ],
    "lib": [
      "ES2020",
      "DOM"
    ],
    "jsx": "react-jsx",
    "customConditions": [
      "source"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "site/**/*.tsx",
    "site/**/*.ts"
  ]
}
