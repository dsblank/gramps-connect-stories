{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsblank.github.io/gramps-connect-stories/spec/1.0/story.schema.json",
  "title": "Gramps Connect Story, format 1.0",
  "description": "The story.json at the root of a .story.zip. See spec/1.0/README.md for the rules this schema can't express (every ref resolves, every src exists in the zip, unknown fields are ignored).",
  "type": "object",
  "required": ["format", "version", "title", "slides", "media"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "gramps-connect-story" },
    "version": {
      "description": "MAJOR.MINOR. This schema validates any 1.x file: newer minor versions only add optional fields.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "title": { "type": "string", "pattern": "\\S" },
    "language": {
      "description": "BCP 47 language tag of the story's text, e.g. \"en\", \"de-CH\".",
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "created": {
      "description": "When the file was written, as an RFC 3339 date-time.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "generator": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "\\S" },
        "version": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "\\S" },
          "url": { "type": "string" }
        }
      }
    },
    "license": {
      "description": "License of the story's content (text and media), as an SPDX identifier or free text.",
      "type": "string"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "basemap": { "enum": ["standard", "historical", "auto", "none"] }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    },
    "media": {
      "description": "Every media file in the story, keyed by an id that slides and overlays refer to.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/mediaItem" }
    },
    "extensions": {
      "description": "Producer-specific data, keyed by namespace. Viewers ignore it.",
      "type": "object",
      "additionalProperties": { "type": "object" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "storyDate": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "description": "The date as it should be shown, in the story's language.",
          "type": "string",
          "pattern": "\\S"
        },
        "edtf": {
          "description": "Optional machine-readable form, in Extended Date/Time Format (ISO 8601-2).",
          "type": "string",
          "pattern": "\\S"
        },
        "sortYear": {
          "description": "Optional year (proleptic Gregorian) that places the slide on the timeline.",
          "type": "integer"
        }
      }
    },
    "slide": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "text": {
          "description": "Body text. Markup: **bold**, *italic*, line breaks. Nothing else is interpreted.",
          "type": "string"
        },
        "date": { "$ref": "#/$defs/storyDate" },
        "place": { "$ref": "#/$defs/place" },
        "media": {
          "type": "array",
          "items": { "$ref": "#/$defs/slideMedia" }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "\\S" },
              "role": { "type": "string" }
            }
          }
        }
      }
    },
    "slideMedia": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/id" },
        "caption": { "type": "string" },
        "credit": { "type": "string" }
      }
    },
    "place": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "geometry": {
          "description": "Optional GeoJSON (RFC 7946) object drawn under the slide's pin: a FeatureCollection, Feature, or bare geometry.",
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "type": "string" } },
          "additionalProperties": true
        },
        "overlays": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlay" }
        }
      },
      "dependentRequired": {
        "lat": ["lon"],
        "lon": ["lat"]
      }
    },
    "lonLat": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "overlay": {
      "type": "object",
      "required": ["media", "corners"],
      "properties": {
        "media": { "$ref": "#/$defs/id" },
        "corners": {
          "description": "[lon, lat] of the image's top-left, top-right, bottom-right and bottom-left corners.",
          "type": "array",
          "items": { "$ref": "#/$defs/lonLat" },
          "minItems": 4,
          "maxItems": 4
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "order": {
          "description": "Stacking order among a slide's overlays; lower is drawn first.",
          "type": "integer"
        },
        "date": { "$ref": "#/$defs/storyDate" }
      }
    },
    "mediaItem": {
      "type": "object",
      "required": ["src", "mime"],
      "properties": {
        "src": {
          "description": "Path of the file inside the zip, relative to its root. No leading slash, no \"..\" segments.",
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\\\]+$"
        },
        "mime": {
          "type": "string",
          "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$"
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alt": { "type": "string" }
      }
    }
  }
}
